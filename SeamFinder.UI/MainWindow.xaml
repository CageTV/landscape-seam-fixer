<Window x:Class="SeamFinder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeamFinder.UI"
        mc:Ignorable="d"
        Title="Landscape Seam Finder" Height="720" Width="1240" MinHeight="520" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3,4,3"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3,4,3"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: banner (if any) -->
            <RowDefinition Height="*"/>      <!-- 1: two columns -->
            <RowDefinition Height="Auto"/>   <!-- 2: action bar (always visible) -->
        </Grid.RowDefinitions>



        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="440"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="12*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: where things are (setup) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <!-- Mode selector -->
                            <GroupBox Header="MOD MANAGER">
                                <WrapPanel>
                                    <RadioButton x:Name="ModeMo2" Content="Mod Organizer 2" GroupName="Mode" IsChecked="True" Checked="Mode_Checked"/>
                                    <RadioButton x:Name="ModeVortex" Content="Vortex" GroupName="Mode" Checked="Mode_Checked"/>
                                    <RadioButton x:Name="ModeDirect" Content="Direct game path (no mod manager)" GroupName="Mode" Checked="Mode_Checked"/>
                                </WrapPanel>
                            </GroupBox>

                            <!-- Mode-specific panels -->
                            <Grid>
                                <!-- MO2 panel -->
                                <GroupBox x:Name="Mo2Panel" Header="MOD ORGANIZER 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Instance folder:"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="Mo2InstancePathBox" TextChanged="Mo2InstancePathBox_TextChanged"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="Mo2BrowseInstance_Click"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile:"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Mo2ProfileCombo"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="(auto-listed)" Style="{StaticResource Hint}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Game Data folder:"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="Mo2GameDataPathBox"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="Mo2BrowseGameData_Click"/>

                                        <Expander Grid.Row="3" Grid.ColumnSpan="3" Header="Advanced: explicit profile file paths" Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="plugins.txt:"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="Mo2PluginsTxtBox"/>
                                                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="Mo2BrowsePluginsTxt_Click"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="loadorder.txt:"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="Mo2LoadOrderTxtBox"/>
                                                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="Mo2BrowseLoadOrderTxt_Click"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="modlist.txt:"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="Mo2ModlistTxtBox"/>
                                                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="Mo2BrowseModlistTxt_Click"/>
                                            </Grid>
                                        </Expander>
                                    </Grid>
                                </GroupBox>

                                <!-- Vortex panel -->
                                <GroupBox x:Name="VortexPanel" Header="VORTEX" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,0,0,8">
                                            Vortex's default deployment method links mods directly into your game's
                                            Data folder, so this is normally the same as your game's own Data path.
                                            If you use a non-default deployment method (symlinks elsewhere, a
                                            separate staging-only mode), point this at wherever Vortex actually
                                            deploys files for this game instead.
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Game Data folder:"/>
                                            <TextBox Grid.Column="1" x:Name="VortexGameDataPathBox" TextChanged="ModeDataPathBox_TextChanged"/>
                                            <Button Grid.Column="2" Content="Browse..." Click="VortexBrowseGameData_Click"/>
                                        </Grid>
                                        <Button Content="Auto-detect from Vortex" HorizontalAlignment="Left" Click="VortexAutoDetect_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Direct panel -->
                                <GroupBox x:Name="DirectPanel" Header="DIRECT GAME PATH" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Game Data folder:"/>
                                        <TextBox Grid.Column="1" x:Name="DirectGameDataPathBox" TextChanged="ModeDataPathBox_TextChanged"/>
                                        <Button Grid.Column="2" Content="Browse..." Click="DirectBrowseGameData_Click"/>
                                    </Grid>
                                </GroupBox>
                            </Grid>

                            <!-- Output -->
                            <GroupBox Header="OUTPUT">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Output folder:"/>
                                        <TextBox Grid.Column="1" x:Name="OutputFolderBox" TextChanged="OutputFolderBox_TextChanged"/>
                                        <Button Grid.Column="2" Content="Browse..." Click="OutputBrowse_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="OutputHintText" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Thin divider (the splitter is the 15px column; the line is drawn in its middle) -->
            <Border Grid.Column="1" Width="1" Background="{StaticResource Border}" HorizontalAlignment="Center" Margin="0,4"/>
            <GridSplitter Grid.Column="1" Width="15" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- RIGHT: what to do, and what happened -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- options -->
                    <RowDefinition Height="*"/>      <!-- log -->
                    <RowDefinition Height="Auto"/>   <!-- result -->
                </Grid.RowDefinitions>

                <!-- Options (scrolls on its own if the window is short, so the log never disappears) -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="380">
                    <GroupBox Header="OPTIONS" Margin="0,0,6,10">
                        <StackPanel>
                            <CheckBox x:Name="TrustNorthernRoadsCheck" Margin="0,0,0,6"
                                                  ToolTip="Northern Roads' Nexus page offers two downloads that both install as a plugin literally named &quot;Northern Roads.esp&quot; - the full terrain-reshaping version and a clutter-only version - so this tool can't tell which one you have from the filename alone. Only check this if you're running the FULL version; leave unchecked for the clutter-only version or if you don't have it installed.">
                                <TextBlock Margin="0" TextWrapping="Wrap" Text="Trust Northern Roads.esp as a base-game-equivalent mod"/>
                            </CheckBox>
                                        <TextBlock Text="Trusted water mods (restores water records only, never landscape - in priority order):" Style="{StaticResource Hint}" Margin="0,0,0,2"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox x:Name="TrustCsWaterModCheck" Margin="0,0,16,0"
                                                      ToolTip="Highest priority - restores CS Water Mod.esp's (and its compatibility patches') water data wherever another mod has silently taken over the record.">
                                <TextBlock Margin="0" TextWrapping="Wrap" Text="CS Water Mod.esp"/>
                            </CheckBox>
                                            <CheckBox x:Name="TrustWaterForEnbCheck" Margin="0,0,16,0"
                                                      ToolTip="Second priority - only wins over CS Water Mod where CS Water Mod isn't also ticked or has no data for that record.">
                                <TextBlock Margin="0" TextWrapping="Wrap" Text="Water for ENB.esp"/>
                            </CheckBox>
                                            <CheckBox x:Name="TrustRealisticWaterTwoCheck" Margin="0,0,16,0"
                                                      ToolTip="Third priority - only wins where neither CS Water Mod nor Water for ENB is ticked or has data for that record.">
                                <TextBlock Margin="0" TextWrapping="Wrap" Text="RealisticWaterTwo.esp"/>
                            </CheckBox>
                                            <CheckBox x:Name="TrustSimplicityOfSeaCheck"
                                                      ToolTip="Lowest priority of the four - only wins where none of CS Water Mod, Water for ENB, or RealisticWaterTwo is ticked or has data for that record. Note: this mod's own plugin filename really is the generic 'water mod.esp' - only an exact filename match, no compatibility-patch family assumed.">
                                <TextBlock Margin="0" TextWrapping="Wrap" Text="Simplicity of Sea (water mod.esp)"/>
                            </CheckBox>
                                        </WrapPanel>
                                        <Expander Header="Additional trusted plugins" Margin="0,0,0,6">
                                            <Grid Margin="6,4,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Trusted (loses to Northern Roads / URF)" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="One per line - an exact plugin filename, or a prefix ending in * to trust a whole patch family (e.g. &quot;My Landscape Mod -*&quot;). Treated the same as Landscape and Water Fixes/Lux Via: trusted for landscape restoration, resolved by load order alongside them - never above Northern Roads or UniqueLocationsRiverwoodForest.esp."
                                                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CustomTrustedPluginsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                                             VerticalScrollBarVisibility="Auto" Height="70" FontFamily="Consolas"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Overrides Northern Roads / URF instead" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Same syntax (one per line, exact name or a *-prefix). These WIN over Northern Roads/UniqueLocationsRiverwoodForest.esp wherever both genuinely edited the same cell - for a mod you want to override the two with, instead of the other way around."
                                                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="PriorityOverNorthernRoadsPluginsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                                             VerticalScrollBarVisibility="Auto" Height="70" FontFamily="Consolas"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander>
                                        <Expander Header="Other trusted water mods" Margin="0,0,0,6">
                                            <StackPanel Margin="6,4,6,0">
                                                <TextBlock Text="For any water-replacer mod without its own checkbox above. Same syntax (one per line, exact plugin filename or a *-prefix). Ranked below all four named water mods, in the order listed here."
                                                           Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <TextBox x:Name="CustomWaterModsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" Height="50" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Expander>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>

                <!-- Log -->
                <GroupBox Grid.Row="1" Header="LOG" Margin="0,0,6,0">
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" Margin="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#FF101216" Foreground="#FFDCDCDC"
                             BorderThickness="0"/>
                </GroupBox>

                <!-- Result bar -->
                <Grid Grid.Row="2" Margin="0,10,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="ResultText" Text="" FontWeight="Bold" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="OpenReportButton" Content="Open Report" IsEnabled="False" Click="OpenReportButton_Click" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" x:Name="OpenFixPluginButton" Content="Open Fix Plugin" IsEnabled="False" Click="OpenFixPluginButton_Click" Margin="0,0,8,0"/>
                            <Button Grid.Column="3" x:Name="OpenFolderButton" Content="Open Folder" IsEnabled="False" Click="OpenFolderButton_Click"/>
                        </Grid>
            </Grid>
        </Grid>

        <!-- Action bar: always on screen, whatever the window height -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                            <Button x:Name="RunButton" Content="Run Detection" Padding="20,7" Click="RunButton_Click"/>
                            <Button x:Name="FixButton" Style="{StaticResource PrimaryButton}" Content="Generate Fix Plugin" Padding="20,7" Margin="8,3,0,3" Click="FixButton_Click"
                                    ToolTip="Fixes isolated cases where a mod's terrain edit borders untouched base-game terrain and the edge doesn't line up. Leaves the mod's data untouched; blends the base-game side toward it. Does not require Run Detection first - independent of the CSV report."/>
                            <ProgressBar x:Name="RunProgress" Width="160" Height="6" Margin="14,0,0,0" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
        </Border>
    </Grid>
</Window>
